---
import { LINKS, SITE } from "@consts";
import { cn } from "@lib/utils";
const { pathname } = Astro.url;
const subpath = pathname.match(/[^/]+/g);
import Container from "@components/Container.astro";

const isActive = (href: string) => pathname === href || "/" + subpath?.[0] === href
---

<header id="header" class="fixed top-0 w-full h-20 z-50">
  <Container size="lg">
    <div class="flex items-center justify-between h-full w-full">
      <a
        href="/"
        aria-label={`${SITE.AUTHOR}, home`}
        class="font-display text-lg font-bold tracking-tight text-foreground hover:text-accent transition-colors duration-200"
      >
        {SITE.AUTHOR}
      </a>

      <div class="flex items-center gap-2">
        <nav
          aria-label="Primary"
          class="hidden md:flex items-center justify-center text-sm gap-1 p-1 rounded-full bg-card/70 backdrop-blur-md border border-card-border"
        >
          {
            LINKS.map((LINK) => (
              <a
                href={LINK.HREF}
                aria-current={isActive(LINK.HREF) ? "page" : undefined}
                class={cn(
                  "h-8 rounded-full px-4 font-medium",
                  "flex items-center justify-center",
                  "transition-colors duration-200 ease-out",
                  isActive(LINK.HREF)
                    ? "bg-foreground text-background"
                    : "text-subtle hover:bg-card-border/50 hover:text-foreground",
                )}
              >
                {LINK.TEXT}
              </a>
            ))
          }
        </nav>

        <button
          id="header-theme-button"
          aria-label="Toggle light and dark theme"
          class="icon-btn"
        >
          <svg class="size-full block dark:hidden stroke-current fill-none">
            <use href="/ui.svg#sun"></use>
          </svg>
          <svg class="size-full hidden dark:block stroke-current fill-none">
            <use href="/ui.svg#moon"></use>
          </svg>
        </button>

        <button
          id="header-drawer-button"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="drawer"
          class="icon-btn md:hidden"
        >
          <svg id="drawer-open" class="size-full stroke-current fill-none">
            <use href="/ui.svg#menu"></use>
          </svg>
          <svg id="drawer-close" class="size-full stroke-current fill-none">
            <use href="/ui.svg#x"></use>
          </svg>
        </button>
      </div>
    </div>
  </Container>
</header>

<style>
  #header-drawer-button > #drawer-open {
    @apply block;
  }

  #header-drawer-button > #drawer-close {
    @apply hidden;
  }

  #header-drawer-button.open > #drawer-open {
    @apply hidden;
  }

  #header-drawer-button.open > #drawer-close {
    @apply block;
  }
</style>

<script is:inline>
  function setDrawer(open) {
    const drawer = document.getElementById("drawer");
    const drawerButton = document.getElementById("header-drawer-button");
    drawer?.classList.toggle("open", open);
    drawerButton?.classList.toggle("open", open);
    drawerButton?.setAttribute("aria-expanded", String(open));
    drawerButton?.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    document.body.classList.toggle("overflow-hidden", open);
  }

  function initializeDrawerButton() {
    const drawerButton = document.getElementById("header-drawer-button");
    if (!drawerButton || drawerButton.dataset.bound) return;
    drawerButton.dataset.bound = "true";
    drawerButton.addEventListener("click", () => {
      setDrawer(!drawerButton.classList.contains("open"));
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setDrawer(false);
    });
  }

  document.addEventListener("astro:after-swap", () => {
    document.body.classList.remove("overflow-hidden");
    initializeDrawerButton();
  });
  initializeDrawerButton();
</script>
