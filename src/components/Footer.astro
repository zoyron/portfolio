---
import { SITE, SOCIALS } from "@consts"
import Container from "@components/Container.astro"
---

<footer class="relative bg-background border-t border-card-border mt-auto">
  <section class="py-12">
    <Container size="lg">
      <div class="flex flex-col md:flex-row items-center justify-between gap-8 md:gap-4">
        <div class="flex flex-col items-center md:items-start gap-2 text-sm">
          <div class="flex items-center gap-4">
            <a href="/legal/terms" class="font-medium text-subtle hover:text-foreground transition-colors duration-200">
              Terms
            </a>
            <a href="/legal/privacy" class="font-medium text-subtle hover:text-foreground transition-colors duration-200">
              Privacy
            </a>
            <a href="/rss.xml" target="_blank" class="font-medium text-subtle hover:text-foreground transition-colors duration-200">
              RSS
            </a>
          </div>
          <div class="text-subtle/70">
            &copy; {new Date().getFullYear()} {SITE.AUTHOR}
          </div>
        </div>

        <div class="flex items-center gap-4 md:gap-6">
          <div class="flex gap-1">
            {
              SOCIALS.map((SOCIAL) => (
                <a
                  href={SOCIAL.HREF}
                  target="_blank"
                  aria-label={`${SITE.AUTHOR} on ${SOCIAL.NAME}`}
                  class="group size-10 flex items-center justify-center rounded-full border border-transparent hover:border-card-border hover:bg-card transition-colors duration-200"
                >
                  <svg class="size-5 fill-subtle group-hover:fill-foreground transition-colors duration-200">
                    <use href={`/social.svg#${SOCIAL.ICON}`} />
                  </svg>
                </a>
              ))
            }
          </div>

          <div class="w-px h-6 bg-card-border"></div>

          <button id="back-to-top" aria-label="Back to top of page" class="icon-btn group">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="size-full stroke-current stroke-2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="19" x2="12" y2="5" class="transition-transform duration-200 ease-out group-hover:-translate-y-0.5" />
              <polyline points="5 12 12 5 19 12" class="transition-transform duration-200 ease-out group-hover:-translate-y-0.5" />
            </svg>
          </button>
        </div>
      </div>
    </Container>
  </section>
</footer>

<script is:inline>
  function goBackToTop(event) {
    event.preventDefault()
    window.scrollTo({
        top: 0,
        behavior: "smooth"
    })
  }

  function initializeBackToTop() {
    const backToTop = document.getElementById("back-to-top")
    backToTop?.addEventListener("click", goBackToTop)
  }

  document.addEventListener("astro:after-swap", initializeBackToTop)
  initializeBackToTop()
</script>
