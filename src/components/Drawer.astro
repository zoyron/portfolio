---
import { SITE, LINKS } from "@consts"
import { cn } from "@lib/utils"
const { pathname } = Astro.url
const subpath = pathname.match(/[^/]+/g)

const isActive = (href: string) => pathname === href || "/" + subpath?.[0] === href
---

<div
  id="drawer"
  class={cn(
    "fixed inset-0 z-40 md:hidden flex flex-col items-center justify-center gap-10",
    "bg-background/95 backdrop-blur-md",
    "opacity-0 pointer-events-none transition-opacity duration-300 ease-out",
  )}
>
  <nav aria-label="Primary" class="flex flex-col items-center gap-2">
    {
      LINKS.map((LINK) => (
        <a
          href={LINK.HREF}
          aria-current={isActive(LINK.HREF) ? "page" : undefined}
          class={cn(
            "font-display text-2xl font-bold px-8 py-3 rounded-full",
            "transition-colors duration-200 ease-out",
            isActive(LINK.HREF)
              ? "bg-foreground text-background"
              : "text-subtle hover:text-foreground hover:bg-card-border/40",
          )}
        >
          {LINK.TEXT}
        </a>
      ))
    }
  </nav>

  <div class="flex items-center gap-3">
    <a href="/rss.xml" target="_blank" aria-label={`RSS feed for ${SITE.TITLE}`} class="icon-btn">
      <svg class="size-full stroke-current fill-none">
        <use href="/ui.svg#rss"></use>
      </svg>
    </a>

    <button id="drawer-theme-button" aria-label="Toggle light and dark theme" class="icon-btn">
      <svg class="size-full block dark:hidden stroke-current fill-none">
        <use href="/ui.svg#sun"></use>
      </svg>
      <svg class="size-full hidden dark:block stroke-current fill-none">
        <use href="/ui.svg#moon"></use>
      </svg>
    </button>
  </div>
</div>

<style>
  #drawer.open {
    @apply opacity-100 pointer-events-auto;
  }
</style>
