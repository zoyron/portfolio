---
import { cn } from "@lib/utils"

type Props = {
  size: "sm" | "md" | "lg" | "xl" | "2xl" | "content"
}

const { size } = Astro.props;
---

<div class={cn(
  "w-full h-full mx-auto px-5",
  size === "sm" && "max-w-screen-sm",
  size === "md" && "max-w-screen-md",
  size === "lg" && "max-w-screen-lg",
  size === "xl" && "max-w-screen-xl",
  size === "2xl" && "max-w-screen-2xl",
  // The reading column every page's content sits in, inset within the lg frame of the header and footer
  size === "content" && "max-w-[46rem]",
)}>
  <slot/>
</div>
