---
---
<canvas id="hero-canvas" class="absolute inset-0 w-full h-full pointer-events-none opacity-0 transition-opacity duration-1000 ease-out" aria-hidden="true"></canvas>

<script>
  import { FluidSim } from "@lib/fluid/fluid"
  import { readPalette } from "@lib/fluid/palette"

  /** Ticks run before the first frame, so the pool opens with a faint wash rather than empty */
  const PRIME_TICKS = 120
  /** A pointer that pauses longer than this, or jumps further, starts a fresh stroke */
  const MAX_GAP_MS = 100
  const MAX_JUMP_PX = 160
  /**
   * An unattended window flows on this long before holding still, so focus that bounces
   * straight back (Cmd-Tab and back, a click into the address bar or DevTools) never stutters
   */
  const IDLE_GRACE_MS = 1000

  function initCanvas() {
    const canvas = document.getElementById("hero-canvas") as HTMLCanvasElement | null
    if (!canvas) return

    // Astro can run this twice on first load; one simulation per canvas
    if (canvas.getAttribute("data-initialized")) return
    canvas.setAttribute("data-initialized", "true")

    const host = canvas.parentElement ?? document.body
    const root = document.documentElement
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches
    const touch = window.matchMedia("(pointer: coarse)").matches

    let sim: FluidSim
    try {
      sim = new FluidSim(canvas, host, { touch })
    } catch {
      // No WebGL2 or no half-float targets: the hero simply stays a calm, plain page
      return
    }

    let dark = root.classList.contains("dark")
    sim.setPalette(readPalette(root), true)
    sim.prime(PRIME_TICKS)
    sim.render()
    canvas.classList.remove("opacity-0")

    // Animation loop: time only advances while frames render, so pausing never causes a jump
    let lastFrame = performance.now()
    let animationFrameId = 0
    let running = false
    let heroVisible = true

    // Attention: a window on screen that nobody is using (no focus, no mouse or pen over it) holds still.
    // Touch screens start attended, since a webview may misreport focus and has no hover to wake it.
    let focused = touch || document.hasFocus()
    let hovered = false
    let attended = focused
    let idleTimer = 0

    const animate = () => {
      if (!running) return
      animationFrameId = requestAnimationFrame(animate)
      const now = performance.now()
      const dt = Math.min((now - lastFrame) / 1000, 0.1)
      lastFrame = now
      if (sim.step(dt)) sim.render()
    }

    const updateRunning = () => {
      // The scroll cue holds with the fluid. Never reached without WebGL2 or under reduced motion, so
      // it can't stick there; set on the hero, not <html>, so a view transition takes it away too
      host.toggleAttribute("data-unattended", !attended)
      const shouldRun = heroVisible && attended && document.visibilityState === "visible" && !reduceMotion
      if (shouldRun && !running) {
        running = true
        lastFrame = performance.now()
        animate()
      } else if (!shouldRun && running) {
        running = false
        cancelAnimationFrame(animationFrameId)
      }
    }

    // Waking is instant; holding still waits out the grace period
    const updateAttention = () => {
      window.clearTimeout(idleTimer)
      if (focused || hovered) {
        attended = true
        updateRunning()
      } else if (attended) {
        idleTimer = window.setTimeout(() => {
          attended = false
          updateRunning()
          // A theme cross-fade cut short by the pause would otherwise hold its halfway colours
          sim.setPalette(readPalette(root), true)
          sim.render()
        }, IDLE_GRACE_MS)
      }
    }

    const onFocus = () => {
      focused = true
      updateAttention()
    }

    const onBlur = () => {
      focused = false
      updateAttention()
    }

    // Pointer: every pointer type stirs, hovering included; nothing is prevented, so touch scrolling is untouched
    const pointers = new Map<number, { x: number; y: number; t: number }>()

    const trackPointer = (e: PointerEvent) => {
      pointers.set(e.pointerId, { x: e.clientX, y: e.clientY, t: e.timeStamp })
    }

    // A mouse or pen over the page is attention, so an unfocused window wakes under it and stirs as usual.
    // Touch is left out: a finger leaves the page after every lift.
    const onPointerOver = (e: PointerEvent) => {
      if (hovered || e.pointerType === "touch") return
      hovered = true
      updateAttention()
    }

    // No relatedTarget: the pointer left the window, or a pen lifted out of range
    const onPointerOut = (e: PointerEvent) => {
      if (!hovered || e.relatedTarget || e.pointerType === "touch") return
      hovered = false
      updateAttention()
    }

    // A finger or pen landing on the hero leaves a drop of ink; a mouse only stirs by moving
    const onPointerDown = (e: PointerEvent) => {
      trackPointer(e)
      // A tap is attention, even where focus is misreported
      if (e.pointerType === "touch" && !focused) onFocus()
      if (!running || e.pointerType === "mouse") return
      const rect = host.getBoundingClientRect()
      const x = e.clientX - rect.left
      const y = e.clientY - rect.top
      if (x >= 0 && y >= 0 && x <= rect.width && y <= rect.height) sim.dab(x, y)
    }

    const onPointerMove = (e: PointerEvent) => {
      // Moving is hovering too, as in a window opened under a resting pointer; noted first,
      // so the move that wakes the loop gets past the check below
      onPointerOver(e)
      const last = pointers.get(e.pointerId)
      trackPointer(e)
      if (!running || !last) return
      // Movement is measured on screen, so scrolling the page under a resting pointer never draws a streak
      const dx = e.clientX - last.x
      const dy = e.clientY - last.y
      if (e.timeStamp - last.t > MAX_GAP_MS || Math.hypot(dx, dy) > MAX_JUMP_PX) return
      const rect = host.getBoundingClientRect()
      sim.pointer(e.clientX - rect.left, e.clientY - rect.top, dx, dy)
    }

    const onPointerEnd = (e: PointerEvent) => {
      pointers.delete(e.pointerId)
    }

    // Resize Handling: redraw at once, since resizing the canvas clears it
    const onResize = () => {
      if (sim.resize()) sim.render()
    }
    window.addEventListener("resize", onResize)
    // The hero's height follows the viewport and its content, so track the host itself too
    const hostResize = new ResizeObserver(onResize)
    hostResize.observe(host)

    // Theme Mutation Observer: re-read the tokens and cross-fade the ink
    const observer = new MutationObserver(() => {
      const isDark = root.classList.contains("dark")
      if (isDark === dark) return
      dark = isDark
      sim.setPalette(readPalette(root), !running)
      if (!running) sim.render()
    })
    observer.observe(root, { attributes: true, attributeFilter: ["class"] })

    const visibility = new IntersectionObserver((entries) => {
      heroVisible = entries.some((entry) => entry.isIntersecting)
      updateRunning()
    }, { threshold: 0 })

    const onVisibilityChange = () => updateRunning()

    // Reduced motion keeps the single still frame drawn above: no loop, no stirring
    if (!reduceMotion) {
      window.addEventListener("pointerdown", onPointerDown, { passive: true })
      window.addEventListener("pointermove", onPointerMove, { passive: true })
      window.addEventListener("pointerup", onPointerEnd, { passive: true })
      window.addEventListener("pointercancel", onPointerEnd, { passive: true })
      window.addEventListener("pointerover", onPointerOver, { passive: true })
      window.addEventListener("pointerout", onPointerOut, { passive: true })
      window.addEventListener("focus", onFocus)
      window.addEventListener("blur", onBlur)
      visibility.observe(host)
      document.addEventListener("visibilitychange", onVisibilityChange)
      updateRunning()
    }

    // Cleanup for Astro view transitions
    document.addEventListener("astro:before-swap", () => {
      running = false
      cancelAnimationFrame(animationFrameId)
      window.clearTimeout(idleTimer)
      window.removeEventListener("resize", onResize)
      hostResize.disconnect()
      window.removeEventListener("pointerdown", onPointerDown)
      window.removeEventListener("pointermove", onPointerMove)
      window.removeEventListener("pointerup", onPointerEnd)
      window.removeEventListener("pointercancel", onPointerEnd)
      window.removeEventListener("pointerover", onPointerOver)
      window.removeEventListener("pointerout", onPointerOut)
      window.removeEventListener("focus", onFocus)
      window.removeEventListener("blur", onBlur)
      document.removeEventListener("visibilitychange", onVisibilityChange)
      visibility.disconnect()
      observer.disconnect()
      sim.dispose()
    }, { once: true })
  }

  // Initialize on load and on view transitions swap
  document.addEventListener("astro:page-load", initCanvas)

  // Also call it immediately for the first load if it's already ready
  if (document.readyState === "complete" || document.readyState === "interactive") {
    initCanvas()
  } else {
    document.addEventListener("DOMContentLoaded", initCanvas)
  }
</script>
