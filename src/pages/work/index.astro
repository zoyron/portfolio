---
import { getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import PageHeading from "@components/PageHeading.astro"
import { formatMonthYear } from "@lib/utils"
import { WORK } from "@consts"

const collection = await getCollection("work")

collection.sort((a, b) => new Date(b.data.dateStart).getTime() - new Date(a.data.dateStart).getTime())

const work = await Promise.all(
  collection.map(async (item) => {
    const { Content } = await item.render()
    return { ...item, Content }
  })
)
---
<PageLayout title={WORK.TITLE} description={WORK.DESCRIPTION}>
  <TopLayout>
    <div class="animate">
      <PageHeading title={WORK.TITLE} description={WORK.DESCRIPTION} />
    </div>
  </TopLayout>
  <BottomLayout>
    <ol class="animate relative pt-6 pb-12 before:absolute before:top-9 before:bottom-0 before:w-px before:left-[0.625rem] md:before:left-[calc(9rem+1.5rem+0.625rem)] before:bg-gradient-to-b before:from-card-border before:via-card-border before:to-transparent">
      {
        work.map((entry) => {
          const dates = `${formatMonthYear(entry.data.dateStart)} – ${formatMonthYear(entry.data.dateEnd)}`
          return (
            <li class="relative grid grid-cols-[1.25rem_1fr] md:grid-cols-[9rem_1.25rem_1fr] gap-x-4 md:gap-x-6 pb-14 last:pb-0">
              <div class="hidden md:block pt-2 text-sm text-subtle tabular-nums">
                {dates}
              </div>

              <div class="flex justify-center pt-2.5" aria-hidden="true">
                <span class="size-2.5 rounded-full bg-foreground ring-4 ring-background"></span>
              </div>

              <div class="pt-0.5">
                <div class="md:hidden text-sm text-subtle tabular-nums mb-2">
                  {dates}
                </div>
                <h2 class="font-display text-2xl font-bold text-foreground">
                  {entry.data.company}
                </h2>
                <p class="text-foreground font-medium mt-1 mb-5">
                  {entry.data.role}
                </p>
                <article class="prose text-subtle prose-p:leading-relaxed max-w-none pb-0">
                  <entry.Content />
                </article>
              </div>
            </li>
          )
        })
      }
    </ol>
  </BottomLayout>
</PageLayout>
