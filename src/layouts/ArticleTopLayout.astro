---
import type { CollectionEntry } from "astro:content"
import { formatDate, readingTime } from "@lib/utils"

type Props = {
  entry: CollectionEntry<"projects"> | CollectionEntry<"blog">
}

const { entry } = Astro.props
const { collection, data, body } = entry
const { title, summary, date, tags } = data

const demoUrl = collection === "projects" ? data.demoUrl : null
const repoUrl = collection === "projects" ? data.repoUrl : null
---

<div>
  <a href={`/${collection}`} class="group inline-flex items-center gap-2 text-sm text-subtle hover:text-foreground transition-colors duration-200">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-200 ease-out group-hover:-translate-x-0.5" aria-hidden="true">
      <line x1="19" y1="12" x2="5" y2="12" />
      <polyline points="12 19 5 12 12 5" />
    </svg>
    Back to {collection}
  </a>

  <div class="mt-10">
    <div class="flex items-center gap-3 text-sm text-subtle">
      <time datetime={date.toISOString()} class="tabular-nums">{formatDate(date)}</time>
      <span aria-hidden="true" class="w-1 h-1 rounded-full bg-card-border"></span>
      <span>{readingTime(body)}</span>
    </div>

    <h1 class="mt-3 text-4xl md:text-5xl font-display font-bold text-foreground leading-tight tracking-tight">
      {title}
    </h1>

    <p class="mt-4 text-lg text-subtle leading-relaxed">
      {summary}
    </p>
  </div>

  {tags && tags.length > 0 && (
    <p class="mt-5 text-sm text-subtle">
      <span class="sr-only">Topics: </span>{tags.join(", ")}
    </p>
  )}

  {(demoUrl || repoUrl) &&
  <div class="mt-6 flex flex-wrap gap-3">
    {demoUrl &&
      <a href={demoUrl} target="_blank" class="btn btn-secondary h-10 px-4">
        <svg class="size-4 fill-current" aria-hidden="true">
          <use href="/ui.svg#globe" />
        </svg>
        <span>View demo</span>
      </a>
    }
    {repoUrl &&
      <a href={repoUrl} target="_blank" class="btn btn-secondary h-10 px-4">
        <svg class="size-4 fill-current" aria-hidden="true">
          <use href="/ui.svg#link" />
        </svg>
        <span>View source</span>
      </a>
    }
  </div>
  }
</div>
