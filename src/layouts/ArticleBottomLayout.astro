---
import { type CollectionEntry, getCollection } from "astro:content"

type Props = {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects">
}

const { entry } = Astro.props
const { collection } = entry
const { Content } = await entry.render()

// Items are newest first, so the previous index is the newer post and the next is the older one
const items = (await getCollection(collection))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
const index = items.findIndex(x => x.slug === entry.slug)
const newer = index > 0 ? items[index - 1] : null
const older = index < items.length - 1 ? items[index + 1] : null
---

<div>
  <article>
    <Content/>
  </article>

  {(newer || older) && (
    <nav aria-label="Nearby posts" class="grid grid-cols-1 sm:grid-cols-2 gap-8 py-10 mt-4 border-t border-card-border">
      {newer ? (
        <a href={`/${newer.collection}/${newer.slug}`} class="group flex flex-col gap-1">
          <span class="text-sm text-subtle">Newer</span>
          <span class="flex items-start gap-2 font-display text-lg font-bold text-foreground leading-snug group-hover:text-accent group-focus-visible:text-accent transition-colors duration-200">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-1.5" aria-hidden="true">
              <line x1="19" y1="12" x2="5" y2="12"/>
              <polyline points="12 19 5 12 12 5"/>
            </svg>
            {newer.data.title}
          </span>
        </a>
      ) : <span class="hidden sm:block"></span>}

      {older && (
        <a href={`/${older.collection}/${older.slug}`} class="group flex flex-col gap-1 sm:items-end sm:text-right">
          <span class="text-sm text-subtle">Older</span>
          <span class="flex items-start gap-2 font-display text-lg font-bold text-foreground leading-snug group-hover:text-accent group-focus-visible:text-accent transition-colors duration-200">
            {older.data.title}
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-1.5" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"/>
              <polyline points="12 5 19 12 12 19"/>
            </svg>
          </span>
        </a>
      )}
    </nav>
  )}
</div>
